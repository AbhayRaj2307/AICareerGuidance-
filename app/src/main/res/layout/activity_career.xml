<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        tools:context=".CareerActivity">

        <TextView
            android:id="@+id/tvCareerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Career Recommendation"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primaryColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvCareerDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Select your interest and skill level to get a tailored career recommendation."
            android:textSize="16sp"
            android:textColor="@color/textColorSecondary"
            app:layout_constraintTop_toBottomOf="@id/tvCareerTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvInterest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Core Interest"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/textColorPrimary"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvCareerDesc"
            app:layout_constraintStart_toStartOf="parent"/>

        <Spinner
            android:id="@+id/spInterest"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/white"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvInterest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSkill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Skill Level"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/textColorPrimary"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/spInterest"
            app:layout_constraintStart_toStartOf="parent"/>

        <Spinner
            android:id="@+id/spSkill"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/white"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvSkill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnGetResult"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Get Recommendation"
            android:layout_marginTop="32dp"
            android:background="@drawable/btn_rounded"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:layout_constraintTop_toBottomOf="@id/spSkill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvCareerResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:text="Your Recommendation"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primaryVariant"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/btnGetResult"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvCareerDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:text="Details will appear here."
            android:textSize="16sp"
            android:textColor="@color/textColorPrimary"
            app:layout_constraintTop_toBottomOf="@id/tvCareerResult"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnRoadmap"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="View Roadmap"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_rounded"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:layout_constraintTop_toBottomOf="@id/tvCareerDetails"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:textColor="@color/primaryColor"
            android:background="?android:attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/btnRoadmap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>